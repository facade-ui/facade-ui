{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/r/**",
        ".generated/**"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },

    "registry": {
      "inputs": [
        "../../packages/registry/**",
        "../../scripts/**",
        "../../pnpm-lock.yaml",
        "demos/**",
        "content/**"
      ],
      "outputs": [
        "public/r/**",
        "public/llms.txt",
        "public/llms-full.txt",
        "public/components/**",
        "public/docs/**",
        ".generated/**"
      ]
    },

    "@facade-ui/docs#typecheck": { "dependsOn": ["^build", "registry"] },
    "@facade-ui/docs#test": {
      "dependsOn": ["^build", "registry"],
      "outputs": ["coverage/**"]
    },
    "@facade-ui/docs#build": {
      "dependsOn": ["^build", "registry"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/r/**",
        "public/llms.txt",
        "public/llms-full.txt",
        "public/components/**",
        "public/docs/**",
        ".generated/**"
      ]
    }
  }
}
