{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "facade-ui",
  "homepage": "https://facadeui.dev",
  "items": [
    {
      "name": "tokens",
      "type": "registry:file",
      "title": "Design tokens",
      "description": "The Facade token layer: shadcn-compatible colour names plus --facade-* display type, section rhythm and motion tokens. Import it from your globals.css.",
      "categories": ["theme"],
      "files": [
        {
          "path": "src/tokens/globals.css",
          "type": "registry:file",
          "target": "styles/facade-tokens.css"
        }
      ]
    },
    {
      "name": "themes",
      "type": "registry:file",
      "title": "Theme presets",
      "description": "Warm and vivid presets applied with data-facade-theme. Neutral is the default and lives in the tokens file.",
      "categories": ["theme"],
      "files": [
        {
          "path": "src/tokens/themes.css",
          "type": "registry:file",
          "target": "styles/facade-themes.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn",
      "description": "Class merging helper: clsx plus tailwind-merge. Identical to shadcn/ui's, so it overwrites nothing meaningful.",
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ],
      "dependencies": ["clsx@^2.1.1", "tailwind-merge@^3.7.0"]
    },
    {
      "name": "types",
      "type": "registry:lib",
      "title": "Section contracts",
      "description": "Shared types every Facade section speaks: heading levels, pluggable image/link components, CTA items.",
      "files": [
        {
          "path": "src/lib/types.ts",
          "type": "registry:lib",
          "target": "lib/types.ts"
        }
      ]
    },
    {
      "name": "motion-primitives",
      "type": "registry:component",
      "title": "Motion primitives",
      "description": "FacadeMotionProvider, FadeIn, Reveal, Stagger and Collapse. Opacity and transform only, with reduced motion honoured.",
      "categories": ["motion"],
      "files": [
        {
          "path": "src/lib/motion.ts",
          "type": "registry:lib",
          "target": "lib/motion.ts"
        },
        {
          "path": "src/motion/facade-motion-provider.tsx",
          "type": "registry:component",
          "target": "components/motion/facade-motion-provider.tsx"
        },
        {
          "path": "src/motion/fade-in.tsx",
          "type": "registry:component",
          "target": "components/motion/fade-in.tsx"
        },
        {
          "path": "src/motion/reveal.tsx",
          "type": "registry:component",
          "target": "components/motion/reveal.tsx"
        },
        {
          "path": "src/motion/stagger.tsx",
          "type": "registry:component",
          "target": "components/motion/stagger.tsx"
        },
        {
          "path": "src/motion/collapse.tsx",
          "type": "registry:component",
          "target": "components/motion/collapse.tsx"
        }
      ],
      "dependencies": ["motion@^13.4.0"],
      "registryDependencies": ["https://facadeui.dev/r/utils.json"]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Base UI Button with Facade variants. Every size clears the 44x44 target minimum.",
      "categories": ["atom"],
      "files": [
        {
          "path": "src/ui/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
