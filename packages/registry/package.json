{
  "name": "@facade-ui/registry",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./motion/*": "./src/motion/*.tsx",
    "./sections/*": "./src/sections/*.tsx",
    "./templates/*": "./src/templates/*.tsx",
    "./tokens/*": "./src/tokens/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@facade-ui/eslint-config": "workspace:*",
    "@facade-ui/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
